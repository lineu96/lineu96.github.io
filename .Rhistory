})
p_kernel <- ggplot(dados, aes(x, y)) +
geom_point(alpha = 0.2, color = "gray50") +
geom_line(data = plot_kern_data, aes(x, pred), color = "darkgreen", size = 1) +
facet_wrap(~kmax) +
labs(title = "Nadaraya-Watson: Efeito do Kernel",
