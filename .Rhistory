dados <- data.frame(x = x, y = y)
#-------------------------------------------------------------------------------
# Definindo 10-fold
ctrl <- trainControl(method = "cv", number = 10)
#-------------------------------------------------------------------------------
# Definindo tema consistente para todos os gráficos
theme_set(theme_minimal(base_size = 12) + theme(legend.position = "bottom"))
model_lm <- train(y ~ x, data = dados, method = "lm", trControl = ctrl)
p_linear <- ggplot(dados, aes(x, y)) +
geom_point(alpha = 0.3, color = "gray50") +
geom_smooth(method = "lm", color = "darkred", se = FALSE, size = 1.2) +
labs(title = "Regressão Linear", subtitle = "Baseline Paramétrico (Alto Viés)")
p_linear
k_valores <- c(3, 15, 50)
plot_knn_data <- map_dfr(k_valores, function(k) {
model <- knnreg(y ~ x, data = dados, k = k)
data.frame(x = dados$x, pred = predict(model, dados), k = factor(paste("k =", k)))
})
p_knn <- ggplot(dados, aes(x, y)) +
geom_point(alpha = 0.2, color = "gray50") +
geom_line(data = plot_knn_data, aes(x, pred), color = "blue", size = 1) +
facet_wrap(~k) +
labs(title = "KNN: Análise de Hiperparâmetros",
