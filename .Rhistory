#  PPGINF - PROGRAMA DE PÓS-GRADUAÇÃO EM INFORMÁTICA
#  DISCIPLINA: TEORIA DO APRENDIZADO ESTATÍSTICO
#-------------------------------------------------------------------------------
#  HANDS-ON AVALIAÇÃO 1
#  AUTOR: Lineu Alberto Cavazani de Freitas (Doutorando)
#-------------------------------------------------------------------------------
#v rm(list=ls())
#-------------------------------------------------------------------------------
# Bibliotecas
library(caret)
library(tidyverse)
library(kknn)
library(patchwork)
#-------------------------------------------------------------------------------
# Geração dos dados
set.seed(1)
n <- 250
x <- sort(runif(n, -3, 3))
y <- sin(x) + rnorm(n, 0, 0.2)
dados <- data.frame(x = x, y = y)
#-------------------------------------------------------------------------------
# Definindo 10-fold
ctrl <- trainControl(method = "cv", number = 10)
#-------------------------------------------------------------------------------
# Definindo tema consistente para todos os gráficos
theme_set(theme_minimal(base_size = 12) + theme(legend.position = "bottom"))
model_lm <- train(y ~ x, data = dados, method = "lm", trControl = ctrl)
p_linear
p_linear <- ggplot(dados, aes(x, y)) +
geom_point(alpha = 0.3, color = "gray50") +
geom_smooth(method = "lm", color = "darkred", se = FALSE, size = 1.2) +
labs(title = "Regressão Linear", subtitle = "Baseline Paramétrico (Alto Viés)")
p_linear
k_valores <- c(3, 15, 50)
plot_knn_data <- map_dfr(k_valores, function(k) {
model <- knnreg(y ~ x, data = dados, k = k)
data.frame(x = dados$x, pred = predict(model, dados), k = factor(paste("k =", k)))
})
plot_knn_data <- map_dfr(k_valores, function(k) {
model <- knnreg(y ~ x, data = dados, k = k)
data.frame(x = dados$x, pred = predict(model, dados), k = factor(paste("k =", k)))
})
plot_knn_data
p_knn <- ggplot(dados, aes(x, y)) +
geom_point(alpha = 0.2, color = "gray50") +
geom_line(data = plot_knn_data, aes(x, pred), color = "blue", size = 1) +
facet_wrap(~k) +
labs(title = "KNN: Análise de Hiperparâmetros",
subtitle = "O aumento de k reduz a variância e aumenta o viés")
p_knn
kmax_valores <- c(5, 20, 100)
plot_kern_data <- map_dfr(kmax_valores, function(k) {
model <- kknn(y ~ x, train = dados, test = dados, k = k, kernel = "gaussian")
data.frame(x = dados$x, pred = predict(model), kmax = factor(paste("kmax =", k)))
})
p_kernel <- ggplot(dados, aes(x, y)) +
geom_point(alpha = 0.2, color = "gray50") +
geom_line(data = plot_kern_data, aes(x, pred), color = "darkgreen", size = 1) +
facet_wrap(~kmax) +
labs(title = "Nadaraya-Watson: Efeito do Kernel",
subtitle = "kmax (bandwidth) controla a suavização local")
p_kernel
final_data <- data.frame(
x = dados$x,
Linear = predict(model_lm, dados),
KNN = predict(best_knn, dados),
Kernel = predict(best_kern, dados)
) %>%
pivot_longer(cols = -x, names_to = "Modelo", values_to = "Predicao") %>%
mutate(Modelo = factor(Modelo, levels = c("Linear", "KNN", "Kernel"))) %>%
mutate(Label = case_when(
Modelo == "Linear" ~ paste("1. Regressão Linear"),
Modelo == "KNN"    ~ paste("2. KNN (k =", best_knn$bestTune$k, ")"),
Modelo == "Kernel" ~ paste("3. Kernel (kmax =", best_kern$bestTune$kmax, ")")
)) %>%
left_join(dados, by = "x")
p_final <- ggplot(final_data, aes(x = x, y = y)) +
geom_point(alpha = 0.2, color = "gray50", size = 1) +
geom_line(aes(y = Predicao, color = Modelo), size = 1.2) +
facet_wrap(~Label) +
scale_color_manual(values = c("Kernel" = "darkgreen",
"KNN" = "blue",
"Linear" = "darkred")) +
theme_minimal(base_size = 12) +
theme(legend.position = "none",
strip.text = element_text(face = "bold")) +
labs(title = "Comparação Final de Modelos Otimizados",
subtitle = "Evolução da complexidade: do modelo global rígido à suavização local",
x = "Variável Explicativa (x)",
y = "Variável Resposta (y)")
