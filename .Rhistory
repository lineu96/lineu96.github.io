scale_color_manual(values = c("Kernel" = "darkgreen",
"KNN" = "blue",
"Linear" = "darkred")) +
theme_minimal(base_size = 12) +
theme(legend.position = "none",
strip.text = element_text(face = "bold")) +
labs(title = "Comparação Final de Modelos Otimizados",
subtitle = "Evolução da complexidade: do modelo global rígido à suavização local",
x = "Variável Explicativa (x)",
y = "Variável Resposta (y)")
print(p_final)
#-------------------------------------------------------------------------------
# Tabela MSE
calc_mse <- function(pred, actual) mean((pred - actual)^2)
tabela_mse <- data.frame(
Modelo = c("Regressão Linear", "KNN", "Nadaraya-Watson"),
Parametro = c("-",
paste("k =", best_knn$bestTune$k),
paste("kmax =", best_kern$bestTune$kmax)),
MSE = c(calc_mse(predict(model_lm, dados), dados$y),
calc_mse(predict(best_knn, dados), dados$y),
calc_mse(predict(best_kern, dados), dados$y))
)
tabela_mse
