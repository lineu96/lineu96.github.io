final_data <- data.frame(
x = dados$x,
Linear = predict(model_lm, dados),
KNN = predict(best_knn, dados),
Kernel = predict(best_kern, dados)
) %>%
pivot_longer(cols = -x, names_to = "Modelo", values_to = "Predicao") %>%
mutate(Modelo = factor(Modelo, levels = c("Linear", "KNN", "Kernel"))) %>%
mutate(Label = case_when(
Modelo == "Linear" ~ paste("1. Regressão Linear"),
Modelo == "KNN"    ~ paste("2. KNN (k =", best_knn$bestTune$k, ")"),
Modelo == "Kernel" ~ paste("3. Kernel (kmax =", best_kern$bestTune$kmax, ")")
)) %>%
left_join(dados, by = "x")
best_knn <- train(y ~ x, data = dados, method = "knn",
tuneGrid = data.frame(k = 1:50), trControl = ctrl)
best_knn
best_kern <- train(y ~ x, data = dados, method = "kknn",
tuneGrid = expand.grid(kmax = 1:50, distance = 2, kernel = "gaussian"),
trControl = ctrl)
best_kern
